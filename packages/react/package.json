  "scripts": {
    "postinstall": "node ./bin/setup.mjs || true",
    "prebuild": "rimraf --glob build build-tests \"*.tsbuildinfo\"",
    "build": "node ../../tools/build-package.mjs --runtime-assets --ignore \"**/*.template.js\" --copy .npmignore",
    "test:public-types": "node ./scripts/test-public-types.mjs",
    "test:dependency-coupling": "node ./scripts/test-dependency-coupling.mjs",
    "test:exports": "pnpm build && node ./scripts/validate-package-exports.mjs",
    "test:engine-compatibility": "node ./scripts/test-engine-compatibility.mjs",
    "test:packed-consumers": "node ./scripts/test-packed-consumers.mjs",
    "test:package": "pnpm build && node ./scripts/validate-package-exports.mjs && publint --pack pnpm && attw --pack ./build --exclude-entrypoints package.json esm cjs styles",
    "release": "pnpm build && pnpm publish",
    "test": "cross-env VITEST_ENV=jsdom vitest",
    "typescript": "tsc -b tsconfig.json"
  },
