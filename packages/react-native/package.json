    "./separator": "./src/separator.tsx",
    "./badge": "./src/badge.tsx",
    "./spinner": "./src/spinner.tsx",
    "./progress-bar": "./src/progress-bar.tsx",
    "./skeleton": "./src/skeleton.tsx",
    "./input": "./src/input.tsx",
    "./text-area": "./src/text-area.tsx",
    "./field": "./src/field.tsx",
    "./checkbox-field": "./src/checkbox-field.tsx",
    "./switch-field": "./src/switch-field.tsx",
    "./search-field": "./src/search-field.tsx",
    "./disclosure": "./src/disclosure.tsx",
    "./tabs": "./src/tabs.tsx",
    "./dialog": "./src/dialog.tsx",
    "./banner": "./src/banner.tsx",
    "./accordion": "./src/accordion.tsx",
