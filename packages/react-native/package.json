    "./breadcrumbs": "./src/breadcrumbs.ts",
    "./pagination": "./src/pagination.ts",
    "./alert-dialog": "./src/alert-dialog.ts",
    "./drawer": "./src/drawer.ts",
    "./toast": "./src/toast.ts"
  },
  "scripts": {
    "prebuild": "rimraf --glob build build-tests \"*.tsbuildinfo\"",
    "build": "node ../../tools/build-package.mjs --minimal && node scripts/finalize-build.mjs",
    "test": "node --test scripts/package-contract.test.mjs scripts/token-provenance.test.mjs && jest --runInBand",
    "test:package": "pnpm build && publint run ./build --pack pnpm && attw --pack ./build",
    "typescript": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@tale-ui/foundations": "workspace:*",
    "@tale-ui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-native": ">=0.83 <0.87"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@testing-library/react-native": "14.0.1",
    "@types/react": "19.2.14",
    "babel-jest": "29.7.0",
    "jest": "29.7.0",
    "react": "19.2.4",
    "react-native": "0.86.0",
    "test-renderer": "1.2.0",
    "typescript": "5.9.3"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "build"
  }
