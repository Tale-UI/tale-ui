{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "build/esm",
    "lib": ["ES2022"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../foundations/tsconfig.build.json"
    },
    {
      "path": "../tokens/tsconfig.build.json"
    }
  ]
}
