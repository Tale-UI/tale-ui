{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "paths": {
      "@tale-ui/tokens/native": ["../tokens/src/native.ts"]
    },
    "rootDir": "./src",
    "outDir": "build/esm",
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../tokens/tsconfig.build.json"
    }
  ]
}
