      "version": "1.0.0",
      "description": "Retrieve one artifact by stable ID or alias.",
      "availability": ["api", "cli", "hosted-mcp"]
    },
    {
      "id": "artifact.search",
      "version": "1.0.0",
      "description": "Search mixed artifact kinds with stable identifiers.",
      "availability": ["api", "cli", "hosted-mcp"]
    },
    {
      "id": "manifest.get",
      "version": "1.0.0",
