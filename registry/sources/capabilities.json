      "availability": ["api", "cli"]
    },
    {
      "id": "component.get",
      "version": "1.0.0",
      "description": "Retrieve the canonical component registry payload.",
      "availability": ["api", "hosted-mcp", "local-mcp"]
    },
    {
      "id": "recipe.get",
      "version": "1.0.0",
