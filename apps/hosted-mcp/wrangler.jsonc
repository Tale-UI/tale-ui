{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tale-ui-hosted-mcp",
  "main": "dist/worker.js",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0,
  },
}
