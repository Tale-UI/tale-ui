{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/extension-trust.schema.json",
  "title": "Tale extension publisher trust and revocation registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "freshness", "publishers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnAfterDays", "failAfterDays"],
      "properties": {
        "warnAfterDays": { "const": 7 },
        "failAfterDays": { "const": 30 }
      }
    },
    "publishers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publisher", "status", "packages", "provenanceRequired", "reviewedAt"],
        "properties": {
          "publisher": { "type": "string" },
          "status": { "enum": ["trusted", "revoked"] },
          "packages": { "type": "array", "items": { "type": "string" } },
          "provenanceRequired": { "type": "boolean" },
          "reviewedAt": { "type": "string", "format": "date-time" },
          "revocation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "effectiveAt"],
            "properties": {
              "reason": { "type": "string" },
              "effectiveAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
