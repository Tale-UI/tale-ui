{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/extension-approval.schema.json",
  "title": "Project-local extension execution approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "package",
    "publisher",
    "version",
    "integrity",
    "capabilities",
    "approvedAt",
    "revoked"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "package": { "type": "string" },
    "publisher": { "type": "string" },
    "version": { "type": "string" },
    "integrity": { "type": "string" },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "approvedAt": { "type": "string", "format": "date-time" },
    "revoked": { "type": "boolean" }
  }
}
