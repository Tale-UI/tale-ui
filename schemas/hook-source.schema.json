{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/hook-source.schema.json",
  "title": "Public hook artifact sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hooks"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^use[A-Z][A-Za-z0-9]+$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path", "packageName", "exportPath", "description"],
            "properties": {
              "name": { "type": "string", "pattern": "^use[A-Z][A-Za-z0-9]+$" },
              "path": { "type": "string", "pattern": "^[^/].+\\.(?:ts|tsx)$" },
              "packageName": { "type": "string", "pattern": "^@tale-ui/[a-z-]+$" },
              "exportPath": { "type": "string", "pattern": "^@tale-ui/[a-z-]+(?:/[a-z-]+)?$" },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  }
}
