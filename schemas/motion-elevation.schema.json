{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/motion-elevation.schema.json",
  "title": "Motion and elevation foundation inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "policy",
    "rawMotion",
    "rawShadows",
    "semanticTokens",
    "platformExceptions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date" },
    "source": { "const": "packages/styles/src" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxRawMotionDeclarations", "maxRawShadowDeclarations"],
      "properties": {
        "mode": { "const": "ratchet" },
        "maxRawMotionDeclarations": { "type": "integer", "minimum": 0 },
        "maxRawShadowDeclarations": { "type": "integer", "minimum": 0 }
      }
    },
    "rawMotion": { "$ref": "#/$defs/inventory" },
    "rawShadows": { "$ref": "#/$defs/inventory" },
    "semanticTokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^--(?:motion|elevation)-[a-z0-9-]+$" }
    },
    "platformExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "scope", "reason", "owner", "reviewBy"],
        "properties": {
          "platform": { "enum": ["web", "react-native"] },
          "scope": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "reviewBy": { "type": "string", "format": "date" }
        }
      }
    }
  },
  "$defs": {
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declarationCount", "files"],
      "properties": {
        "declarationCount": { "type": "integer", "minimum": 0 },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "count"],
            "properties": {
              "path": { "type": "string", "pattern": "^packages/styles/src/.+\\.css$" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
