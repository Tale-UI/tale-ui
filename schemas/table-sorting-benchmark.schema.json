{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/table-sorting-benchmark.schema.json",
  "title": "Stable Table sorting benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "method", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "platform", "architecture", "logicalCpuCount", "totalMemoryBytes"],
      "properties": {
        "node": { "type": "string" },
        "platform": { "type": "string" },
        "architecture": { "type": "string" },
        "logicalCpuCount": { "type": "integer", "minimum": 1 },
        "totalMemoryBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "warmupIterations", "measuredIterations", "clock"],
      "properties": {
        "runtime": { "const": "packages/react/src/table/TableController.ts" },
        "warmupIterations": { "type": "integer", "minimum": 1 },
        "measuredIterations": { "type": "integer", "minimum": 5 },
        "clock": { "const": "performance.now" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "operation", "rowCount", "samplesMs", "summaryMs", "resultDigest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "operation": { "const": "stable-sort" },
          "rowCount": { "enum": [1000, 10000] },
          "samplesMs": {
            "type": "array",
            "minItems": 5,
            "items": { "type": "number", "minimum": 0 }
          },
          "summaryMs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimum", "median", "p95", "maximum"],
            "properties": {
              "minimum": { "type": "number", "minimum": 0 },
              "median": { "type": "number", "minimum": 0 },
              "p95": { "type": "number", "minimum": 0 },
              "maximum": { "type": "number", "minimum": 0 }
            }
          },
          "resultDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}
