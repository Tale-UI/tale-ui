{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/migration.schema.json",
  "title": "Tale migration manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "order",
    "from",
    "to",
    "transforms",
    "affectedArtifacts",
    "reversible",
    "idempotent",
    "checksum"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "order": { "type": "integer", "minimum": 0 },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "transforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": { "enum": ["javascript", "typescript", "css", "config"] },
          "path": { "type": "string" }
        }
      }
    },
    "affectedArtifacts": { "type": "array", "items": { "type": "string" } },
    "reversible": { "type": "boolean" },
    "backupPolicy": { "enum": ["required", "optional", "none"] },
    "idempotent": { "const": true },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
