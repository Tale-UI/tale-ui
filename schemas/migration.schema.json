{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/migration.schema.json",
  "title": "Tale migration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "order",
    "group",
    "description",
    "from",
    "to",
    "dependencies",
    "transforms",
    "affectedArtifacts",
    "deprecations",
    "sourceEvidence",
    "parsers",
    "sensitiveFiles",
    "generatedFiles",
    "reversible",
    "backupPolicy",
    "idempotent",
    "checksum"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "order": { "type": "integer", "minimum": 0 },
    "group": {
      "enum": ["package-rename", "deprecated-api", "token-name", "import-path"]
    },
    "description": { "type": "string", "minLength": 1 },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "transforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "files"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["javascript", "typescript", "css", "config"] },
          "path": { "type": "string" },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "affectedArtifacts": { "type": "array", "items": { "type": "string" } },
    "deprecations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "replacementId", "documentation"],
        "properties": {
          "id": { "type": "string" },
          "replacementId": { "type": "string" },
          "documentation": { "type": "string", "format": "uri" }
        }
      }
    },
    "sourceEvidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "parsers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["text", "json", "css", "typescript"] }
    },
    "sensitiveFiles": { "const": "require-explicit" },
    "generatedFiles": { "const": "require-explicit" },
    "reversible": { "type": "boolean" },
    "backupPolicy": { "enum": ["required", "optional", "none"] },
    "idempotent": { "const": true },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
