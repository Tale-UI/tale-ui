{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/recovery.schema.json",
  "title": "Mutation recovery request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recoveryId",
    "operationId",
    "journalDigest",
    "action",
    "recoveryDigest",
    "preRecoveryDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "recoveryId": { "type": "string" },
    "operationId": { "type": "string" },
    "journalDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "action": { "enum": ["resume", "rollback"] },
    "recoveryDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "preRecoveryDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
