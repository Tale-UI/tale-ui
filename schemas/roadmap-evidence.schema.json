{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/roadmap-evidence.schema.json",
  "title": "Tale UI roadmap completion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "traceability",
    "reviewBundle",
    "overallStatus",
    "automatedSummary",
    "manualSummary",
    "records",
    "operationalInputs"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "traceability": { "const": "registry/roadmap-traceability.json" },
    "reviewBundle": { "const": "Bundle BC pull request" },
    "overallStatus": { "const": "ready-for-consolidated-review" },
    "automatedSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total"],
      "properties": {
        "passed": { "const": 58 },
        "total": { "const": 58 }
      }
    },
    "manualSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "total"],
      "properties": {
        "pending": { "const": 58 },
        "total": { "const": 58 }
      }
    },
    "records": {
      "type": "array",
      "minItems": 58,
      "maxItems": 58,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "automatedStatus", "manualStatus", "manualEvidenceAndOwner", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^(R[0-9]{2}\\.[0-9]|SM[0-9]{2})$" },
          "automatedStatus": { "const": "passed" },
          "manualStatus": { "const": "pending-consolidated-pr-review" },
          "manualEvidenceAndOwner": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "digest"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              }
            }
          }
        }
      }
    },
    "operationalInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "status", "behavior", "authority"],
        "properties": {
          "input": { "type": "string", "minLength": 1 },
          "status": { "const": "unavailable-not-blocking-local-acceptance" },
          "behavior": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
