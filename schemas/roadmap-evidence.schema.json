{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/roadmap-evidence.schema.json",
  "title": "Tale UI roadmap completion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "traceability",
    "reviewBundle",
    "overallStatus",
    "automatedSummary",
    "manualSummary",
    "records",
    "completion",
    "operationalInputs"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "traceability": { "const": "registry/roadmap-traceability.json" },
    "reviewBundle": { "const": "Bundle BC pull request #9" },
    "overallStatus": { "const": "complete" },
    "automatedSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total"],
      "properties": {
        "passed": { "const": 58 },
        "total": { "const": 58 }
      }
    },
    "manualSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total"],
      "properties": {
        "passed": { "const": 58 },
        "total": { "const": 58 }
      }
    },
    "records": {
      "type": "array",
      "minItems": 58,
      "maxItems": 58,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "automatedStatus", "manualStatus", "manualEvidenceAndOwner", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^(R[0-9]{2}\\.[0-9]|SM[0-9]{2})$" },
          "automatedStatus": { "const": "passed" },
          "manualStatus": { "const": "passed-consolidated-pr-review" },
          "manualEvidenceAndOwner": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "digest"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              }
            }
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completedAt", "pullRequest", "postMergeChecks"],
      "properties": {
        "completedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "pullRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "url", "reviewedHead", "mergeCommit", "mergedAt", "mergedBy"],
          "properties": {
            "number": { "const": 9 },
            "url": { "const": "https://github.com/Tale-UI/tale-ui/pull/9" },
            "reviewedHead": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "mergeCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "mergedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "mergedBy": { "type": "string", "minLength": 1 }
          }
        },
        "postMergeChecks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workflow", "runId", "url", "headCommit", "conclusion", "completedAt"],
            "properties": {
              "workflow": { "enum": ["CI", "Deploy Pages"] },
              "runId": { "type": "integer", "minimum": 1 },
              "url": {
                "type": "string",
                "pattern": "^https://github\\.com/Tale-UI/tale-ui/actions/runs/[0-9]+$"
              },
              "headCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "conclusion": { "const": "success" },
              "completedAt": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              }
            }
          }
        }
      }
    },
    "operationalInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "status", "behavior", "authority"],
        "properties": {
          "input": { "type": "string", "minLength": 1 },
          "status": { "const": "unavailable-not-blocking-local-acceptance" },
          "behavior": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
