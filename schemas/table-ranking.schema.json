{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/table-ranking.schema.json",
  "title": "Table plugin evidence ranking",
  "type": "object",
  "required": ["schemaVersion", "evidenceRevision", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "evidenceRevision": { "type": "string" },
    "records": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "candidate",
          "demandEvidence",
          "reactAriaCompatibility",
          "accessibilityRisks",
          "stateModel",
          "ssrHydration",
          "performance",
          "cost",
          "disposition",
          "rank",
          "evidenceDigest"
        ],
        "properties": {
          "candidate": { "type": "string" },
          "demandEvidence": { "type": "array", "minItems": 1 },
          "reactAriaCompatibility": { "type": "string" },
          "accessibilityRisks": { "type": "array" },
          "stateModel": { "type": "string" },
          "ssrHydration": { "type": "string" },
          "performance": {
            "type": "object",
            "required": ["rows1k", "rows10k"],
            "properties": {
              "rows1k": { "type": "string" },
              "rows10k": { "type": "string" }
            }
          },
          "cost": { "type": "object" },
          "disposition": { "enum": ["approve", "defer", "reject"] },
          "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
          "evidenceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}
