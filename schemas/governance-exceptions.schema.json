{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/governance-exceptions.schema.json",
  "title": "Governance exceptions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exceptions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scope", "gate", "owner", "rationale", "approvedOn", "expiresOn"],
        "properties": {
          "id": { "type": "string", "pattern": "^EX-[0-9]{4}$" },
          "scope": { "type": "string", "minLength": 1 },
          "gate": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "rationale": { "type": "string", "minLength": 20 },
          "approvedOn": { "type": "string", "format": "date" },
          "expiresOn": { "type": "string", "format": "date" },
          "trackingIssue": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
