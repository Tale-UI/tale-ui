{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/i18n-catalog.schema.json",
  "title": "Tale UI operational message catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "messages"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "messages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]*(?:\\.[a-z][a-zA-Z0-9]*)+$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
