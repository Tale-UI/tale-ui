{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/manual-accessibility-evidence.schema.json",
  "title": "Retained manual accessibility evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "modalities"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stablePromotionRequiresPass", "retention"],
      "properties": {
        "stablePromotionRequiresPass": { "const": true },
        "retention": { "const": "repository-record" }
      }
    },
    "modalities": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modality", "status", "scope", "owner", "evidence"],
        "properties": {
          "modality": {
            "enum": ["screen-reader", "zoom-reflow", "keyboard", "touch", "reduced-motion"]
          },
          "status": { "enum": ["passed", "changes-required", "pending-manual"] },
          "scope": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "testedOn": { "type": "string", "format": "date" },
          "reviewBy": { "type": "string", "format": "date" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "pending-manual" } },
              "required": ["status"]
            },
            "then": { "required": ["reviewBy"] },
            "else": { "required": ["testedOn"] }
          }
        ]
      }
    }
  }
}
