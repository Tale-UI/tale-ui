{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/conformance.schema.json",
  "title": "Cross-platform token conformance report",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceDigest",
    "platform",
    "appearance",
    "highContrast",
    "matched",
    "exceptions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "platform": { "enum": ["web", "react-native"] },
    "appearance": { "enum": ["light", "dark"] },
    "highContrast": { "enum": ["supported", "guided", "not-applicable"] },
    "matched": { "type": "array", "items": { "type": "string" } },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token", "reason", "owner", "reviewBy"],
        "properties": {
          "token": { "type": "string" },
          "reason": { "type": "string" },
          "owner": { "type": "string" },
          "reviewBy": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
