{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/roadmap-traceability.schema.json",
  "title": "Tale UI roadmap traceability registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "sourceDigest", "criteria"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "source": {
      "const": "docs/plans/prioritized-roadmap-implementation-plan.md"
    },
    "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement",
          "deliverable",
          "automatedVerification",
          "manualEvidenceAndOwner",
          "releaseGate"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^(R[0-9]{2}\\.[0-9]|SM[0-9]{2})$" },
          "requirement": { "type": "string", "minLength": 1 },
          "deliverable": { "type": "string", "minLength": 1 },
          "automatedVerification": { "type": "string", "minLength": 1 },
          "manualEvidenceAndOwner": { "type": "string", "minLength": 1 },
          "releaseGate": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
