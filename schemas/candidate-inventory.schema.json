{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/candidate-inventory.schema.json",
  "title": "Evidence-gated roadmap candidate inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inventory", "source", "status", "candidates"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "inventory": { "enum": ["table", "app-shell", "chat", "content", "extensions"] },
    "source": { "type": "string" },
    "status": { "const": "frozen" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
