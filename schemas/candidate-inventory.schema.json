{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/candidate-inventory.schema.json",
  "title": "Evidence-gated roadmap candidate inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inventory", "source", "status", "candidates"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "inventory": {
      "enum": [
        "table",
        "app-shell",
        "chat",
        "content",
        "extensions",
        "component-equivalence-expansion"
      ]
    },
    "source": { "type": "string" },
    "status": { "const": "frozen" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "oneOf": [
    {
      "properties": {
        "inventory": { "enum": ["table", "app-shell", "chat", "content", "extensions"] }
      }
    },
    {
      "properties": {
        "inventory": { "const": "component-equivalence-expansion" },
        "source": {
          "const": "docs/plans/component-equivalence-expansion-implementation-plan.md"
        },
        "candidates": {
          "type": "array",
          "prefixItems": [
            { "const": "AspectRatio" },
            { "const": "Blockquote" },
            { "const": "ButtonGroup" },
            { "const": "Citation" },
            { "const": "Code" },
            { "const": "Lightbox" },
            { "const": "Markdown" },
            { "const": "Outline" },
            { "const": "OverflowList" },
            { "const": "Resizable" },
            { "const": "Skeleton" },
            { "const": "Timestamp" },
            { "const": "Toast" }
          ],
          "items": false,
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true
        }
      }
    }
  ]
}
