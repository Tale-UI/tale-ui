{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tale-ui.dev/schemas/template.schema.json",
  "title": "Installable Tale template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "source",
    "skeleton",
    "dependencies",
    "preview",
    "golden",
    "compatibility",
    "appearance",
    "rtl",
    "provenance",
    "license",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^tale:template:[a-z0-9][a-z0-9-]+$" },
    "version": { "type": "string" },
    "source": { "type": "string", "pattern": "^source/" },
    "skeleton": { "type": "string", "pattern": "^skeleton/" },
    "dependencies": { "type": "object", "additionalProperties": { "type": "string" } },
    "preview": { "type": "object" },
    "golden": { "type": "string" },
    "compatibility": { "type": "object" },
    "appearance": { "type": "array", "contains": { "const": "light" } },
    "rtl": { "type": "boolean" },
    "provenance": { "type": "object" },
    "license": { "type": "string" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
